# Neon Postgres in production. Leave unset locally to use PGLite.
DATABASE_URL=

# Protects POST/GET /api/cron/*. Vercel cron and your own curl both send:
#   Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Off-the-water email (6pm Eastern Vercel cron) — not wired yet.
# RESEND_API_KEY=
# REMINDER_TO=
