# Neon Postgres in production. Leave unset locally to use PGLite.
DATABASE_URL=

# Protects POST/GET /api/cron/*. Vercel cron and your own curl both send:
#   Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Marketplace Redis (Storage → Upstash). Vercel KV was retired; these are the
# names the Redis integration injects. Either pair works.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Web Push. Public key is also baked into the client; private stays on Vercel.
VAPID_PUBLIC_KEY=BHLuym4du_T_Sdvx-3G_UcCMzf_m3Ny0NzEkllGvMlaxCWHTiWCIeLidDkCRcL2T5cNvZr4ZukQvltUJSctssaQ
VAPID_PRIVATE_KEY=
